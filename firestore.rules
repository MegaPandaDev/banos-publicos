rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /banos/{id} {
      // Cualquiera puede ver los baños (no ocultos o no, filtramos en el cliente).
      allow read: if true;

      // Crear un baño nuevo: solo con los campos esperados y valores iniciales correctos.
      allow create: if request.auth != null
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.descripcion is string
                    && request.resource.data.descripcion.size() <= 300
                    && request.resource.data.lat is number
                    && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                    && request.resource.data.lng is number
                    && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
                    && request.resource.data.reportes == 0
                    && request.resource.data.oculto == false
                    && request.resource.data.creadoPor == request.auth.uid;

      // Actualizar: SOLO se permite incrementar "reportes" en 1, y "oculto" tiene que
      // coincidir exactamente con el umbral (3) — así nadie puede ocultar un baño con
      // una sola llamada directa a Firestore ni forzar el valor contrario.
      // Además, cada uid solo puede contar una vez (ver /reportes/{uid} más abajo).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportes', 'oculto'])
                    && request.resource.data.reportes == resource.data.reportes + 1
                    && request.resource.data.oculto == (request.resource.data.reportes >= 3)
                    && !exists(/databases/$(database)/documents/banos/$(id)/reportes/$(request.auth.uid));

      // Nadie borra documentos desde el cliente.
      allow delete: if false;

      // Un reporte por usuario anónimo y baño (el id del documento es el uid).
      // Solo existe para que la regla de arriba pueda comprobar "¿ya reportó este uid?";
      // no se puede leer, actualizar ni borrar.
      match /reportes/{uid} {
        allow read: if false;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }

      // Una valoración (1-5 estrellas) por usuario anónimo y baño.
      // El id del documento es el uid, así cada persona solo puede tener/editar la suya.
      match /valoraciones/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && request.resource.data.estrellas is int
                              && request.resource.data.estrellas >= 1
                              && request.resource.data.estrellas <= 5;
        allow delete: if false;
      }

      // Comentarios anónimos: solo el autor puede editar (solo el texto) o borrar el suyo.
      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.creadoPor == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 400;
        allow update: if request.auth != null
                      && request.auth.uid == resource.data.creadoPor
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto'])
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 400;
        allow delete: if request.auth != null && request.auth.uid == resource.data.creadoPor;
      }
    }
  }
}
