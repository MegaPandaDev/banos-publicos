# Copia este archivo a ".env" (sin el ".example") y rellena los valores reales.
# ".env" nunca se sube al repositorio (está en .gitignore).

# Cadena de conexión de Neon. La encuentras en el panel de Neon, dentro de tu
# proyecto -> "Connection string" (elige "Pooled connection" si te da a elegir).
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/nombre_basedatos?sslmode=require

# Identificador del moderador (se obtiene visitando la web con "?verid" en la
# URL una vez desplegada, y pegando aquí el valor que aparezca). Déjalo vacío
# mientras tanto: sin él, nadie tiene permisos de moderador.
MODERADOR_ID=

# Cloudflare Turnstile. Déjalas vacías para probar sin captcha (modo "sin
# configurar": todo funciona igual, sin ninguna verificación).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
